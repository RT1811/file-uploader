<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Log In</title>
</head>
<body>
  <h1>Log In</h1>

  <form method="POST" action="/log-in">
    <label for="username">Username</label>
    <input
      type="text"
      id="username"
      name="username"
      required
    >

    <label for="password">Password</label>
    <input
      type="password"
      id="password"
      name="password"
      required
    >

    <button type="submit">Log In</button>
  </form>

  <a href="/sign-up">Create Account</a>
</body>
</html>