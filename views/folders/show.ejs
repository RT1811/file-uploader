<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><% folder.name %>></title>
</head>
<body>
    <h1><%= folder.name %></h1>

    <h2>Folders</h2>

    <% folder.childFolders.forEach((child) => { %>
    <a href="/folders/<%= child.id %>">
        <%= child.name %>
    </a>
    <% }) %>

    <h2>Files</h2>

    <% folder.files.forEach((file) => { %>
    <p><%= file.name %></p>
    <% }) %>
</body>